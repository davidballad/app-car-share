{
  "name": "ecuador-rideshare",
  "version": "1.0.0",
  "description": "Inter-city rideshare application for Ecuador",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run backend:dev\" \"npm run mobile:start\"",
    "backend:dev": "cd backend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "mobile:start": "cd mobile && npm start",
    "mobile:android": "cd mobile && npm run android",
    "mobile:ios": "cd mobile && npm run ios",
    "install:all": "npm install && cd backend && npm install && cd ../mobile && npm install"
  },
  "keywords": [
    "rideshare",
    "ecuador",
    "transportation"
  ],
  "author": "Ecuador Rideshare Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^8.2.2"
  }
}
